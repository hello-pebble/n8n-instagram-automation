{
  "name": "릴스 업로드 v3 (오래된 순 하나씩)",
  "nodes": [
    {
      "parameters": {},
      "id": "r1",
      "name": "수동 실행",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "ig_user_id",
              "value": "여기에_user_id_숫자",
              "type": "string"
            },
            {
              "id": "s2",
              "name": "base_url",
              "value": "https://여기에_도메인/media",
              "type": "string"
            },
            {
              "id": "s4",
              "name": "series",
              "value": "여기에_캐릭터이름",
              "type": "string"
            },
            {
              "id": "s6",
              "name": "hashtags",
              "value": "#인스타툰 #AI생성",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r2",
      "name": "설정",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $('설정').first().json;\nconst episode = $('첫 번째만').first().json.episode;\nconst title = String($input.first().json.data ?? '').replace(/^﻿/, '').split(/\\r?\\n/)[0].trim();\nif (!title) throw new Error(`title.txt가 비어 있어요: ${episode}`);\nif (/#\\s*\\d/.test(title)) throw new Error(`제목에 #숫자는 쓸 수 없어요(해시태그로 변환돼요): ${title}`);\nconst m = episode.match(/^(\\d{4}-\\d{2}-\\d{2})_(\\d{3})$/);\nif (!m) throw new Error(`episode 형식 오류: ${episode}`);\nconst epNo = Number(m[2]);\nconst base = String(s.base_url).replace(/\\/$/, '');\nconst caption = `[${s.series} ${epNo}화] ${title}\\n\\n${s.hashtags}`;\nreturn [{ json: { video_url: `${base}/${episode}/reel.mp4`, caption, episode } }];"
      },
      "id": "r3",
      "name": "영상 주소·캡션 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/{{ $('설정').first().json.ig_user_id }}/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{ $json.video_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.caption }}"
            },
            {
              "name": "share_to_feed",
              "value": "true"
            },
            {
              "name": "is_ai_generated",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "r4",
      "name": "릴스 등록 (AI 라벨)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "creation_id",
              "value": "={{ $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r5",
      "name": "게시할 ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2400,
        200
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "id": "r6",
      "name": "30초 기다리기",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2600,
        200
      ],
      "webhookId": "reel-wait-a"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.instagram.com/{{ $('게시할 ID').first().json.creation_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status_code"
            }
          ]
        },
        "options": {}
      },
      "id": "r7",
      "name": "상태 확인",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2800,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "if1",
              "leftValue": "={{ $json.status_code }}",
              "rightValue": "FINISHED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "r8",
      "name": "처리 끝났나?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3000,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "if2",
              "leftValue": "={{ $json.status_code }}",
              "rightValue": "IN_PROGRESS",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "r9",
      "name": "실패인가?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3200,
        400
      ]
    },
    {
      "parameters": {
        "errorMessage": "=릴스 처리 실패: {{ $json.status_code }} (영상 형식·길이·주소를 확인하세요)"
      },
      "id": "r10",
      "name": "중단",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        3400,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.instagram.com/{{ $('설정').first().json.ig_user_id }}/media_publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $('게시할 ID').first().json.creation_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "r11",
      "name": "게시하기",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3200,
        100
      ]
    },
    {
      "id": "g1",
      "name": "이미 올렸나? 확인",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        800,
        200
      ],
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "posted"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "episode",
              "keyValue": "={{ $json.episode }}"
            },
            {
              "keyName": "kind",
              "keyValue": "reel"
            }
          ]
        }
      }
    },
    {
      "id": "g2",
      "name": "올린 기록 남기기",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        3400,
        100
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "posted"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "episode": "={{ $('영상 주소·캡션 만들기').first().json.episode }}",
            "kind": "reel"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "episode",
              "displayName": "episode",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            },
            {
              "id": "kind",
              "displayName": "kind",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      }
    },
    {
      "id": "n4",
      "name": "첫 번째만",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        1600,
        200
      ],
      "parameters": {
        "maxItems": 1
      }
    },
    {
      "id": "n5",
      "name": "제목 읽기",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('설정').first().json.base_url.replace(/\\/$/, '') }}/{{ $json.episode }}/title.txt",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "m1",
      "name": "파일 목록 읽기",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/files/media/*/title.txt",
        "options": {}
      }
    },
    {
      "id": "m2",
      "name": "에피소드 정렬",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        200
      ],
      "parameters": {
        "jsCode": "const eps = [];\nfor (const it of $input.all()) {\n  const dir = it.binary && it.binary.data && it.binary.data.directory;\n  if (!dir) continue;\n  const ep = String(dir).split('/').filter(Boolean).pop();\n  if (/^\\d{4}-\\d{2}-\\d{2}_\\d{3}$/.test(ep)) eps.push(ep);\n}\nreturn [...new Set(eps)].sort().map((episode) => ({ json: { episode } }));"
      }
    },
    {
      "id": "m3",
      "name": "올릴 파일 확인 후보",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "jsCode": "const s = $('설정').first().json;\nconst base = String(s.base_url).replace(/\\/$/, '');\nreturn $input.all().map((it) => ({ json: { episode: it.json.episode, url: `${base}/${it.json.episode}/reel.mp4` } }));"
      }
    },
    {
      "id": "m4",
      "name": "올릴 파일 확인",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "method": "HEAD",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "m5",
      "name": "준비된 것만 고르기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        200
      ],
      "parameters": {
        "jsCode": "const cands = $('올릴 파일 확인 후보').all();\nconst res = $input.all();\nconst ready = new Set();\ncands.forEach((c, i) => { if (res[i] && res[i].json.statusCode === 200) ready.add(c.json.episode); });\nreturn $('이미 올렸나? 확인').all()\n  .filter((it) => ready.has(it.json.episode))\n  .map((it) => ({ json: { episode: it.json.episode } }));"
      }
    }
  ],
