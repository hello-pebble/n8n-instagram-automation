    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst folder = String(s.episode).trim();\nconst m = folder.match(/^(\\d{4}-\\d{2}-\\d{2})_(\\d{3})$/);\nif (!m) {\n  throw new Error(`episode는 2026-10-28_001 형식이어야 해요. 지금 값: ${s.episode}`);\n}\nconst epNo = Number(m[2]);\nconst cover = String(s.has_cover).trim().toLowerCase();\nif (!['yes', 'no'].includes(cover)) {\n  throw new Error(`has_cover는 yes 또는 no여야 해요. 지금 값: ${s.has_cover}`);\n}\nconst n = Number(s.cut_count);\nconst start = cover === 'yes' ? 0 : 1;\nconst total = n + (cover === 'yes' ? 1 : 0);\nif (!Number.isInteger(n) || n < 0 || total < 1 || total > 20) {\n  throw new Error(`표지 포함 1~20장이어야 해요. 지금: 표지 ${cover}, cut_count ${s.cut_count}`);\n}\nconst base = s.base_url.replace(/\\/$/, '');\nconst caption = `[${s.series} ${epNo}화] ${s.title}\\n\\n📝 대본: 직접 씀 / 🎨 그림: AI 생성\\n\\n${s.hashtags}`;\nreturn Array.from({ length: total }, (_, i) => ({\n  json: { image_url: `${base}/${folder}/${String(start + i).padStart(2, '0')}.jpg`, caption, cut_count: total }\n}));"
      },
      "id": "b3",
      "name": "컷 주소·캡션 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
