    {
      "parameters": {
        "jsCode": "const s = $('설정').first().json;\nconst c = $('컷 수 계산').first().json;\nconst title = String($input.first().json.data ?? '').replace(/^﻿/, '').split(/\\r?\\n/)[0].trim();\nif (!title) throw new Error(`title.txt가 비어 있어요: ${c.episode}`);\nif (/#\\s*\\d/.test(title)) throw new Error(`제목에 #숫자는 쓸 수 없어요(해시태그로 변환돼요): ${title}`);\nconst m = c.episode.match(/^(\\d{4}-\\d{2}-\\d{2})_(\\d{3})$/);\nif (!m) throw new Error(`episode 형식 오류: ${c.episode}`);\nconst epNo = Number(m[2]);\nif (c.total > 20) throw new Error(`이미지는 20장 이하여야 해요: ${c.total}장`);\nconst base = String(s.base_url).replace(/\\/$/, '');\nconst caption = `[${s.series} ${epNo}화] ${title}\\n\\n📝 대본: 직접 씀 / 🎨 그림: AI 생성\\n\\n${s.hashtags}`;\nreturn Array.from({ length: c.total }, (_, i) => ({\n  json: {\n    image_url: `${base}/${c.episode}/${String(c.start + i).padStart(2, '0')}.jpg`,\n    caption,\n    cut_count: c.total,\n    episode: c.episode,\n  },\n}));"
      },
