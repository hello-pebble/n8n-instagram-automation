      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        5000,
        200
      ],
      "parameters": {
        "operation": "write",
        "fileName": "=/files/media/{{ $('올린 기록 남기기').first().json.episode }}/posted_cuts.marker",
        "dataPropertyName": "data",
        "options": {}
      }
    }
