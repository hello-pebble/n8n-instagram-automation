    {
      "id": "n5",
      "name": "컷 후보 만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        200
      ],
      "parameters": {
        "jsCode": "const s = $('설정').first().json;\nconst base = String(s.base_url).replace(/\\/$/, '');\nconst episode = $input.first().json.episode;\nconst out = [];\nfor (let i = 0; i <= 20; i++) {\n  out.push({ json: { episode, url: `${base}/${episode}/${String(i).padStart(2, '0')}.jpg` } });\n}\nreturn out;"
      }
    },
    {
      "id": "n6",
      "name": "컷 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "method": "HEAD",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "n7",
      "name": "컷 수 계산",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        200
      ],
      "parameters": {
        "jsCode": "const episode = $('컷 후보 만들기').first().json.episode;\nconst ok = $input.all().map((r) => r.json.statusCode === 200);\nconst hasCover = ok[0];\nconst start = hasCover ? 0 : 1;\nlet total = 0;\nfor (let i = start; i < ok.length && ok[i]; i++) total++;\nif (ok.slice(start + total).some(Boolean)) throw new Error(`컷 번호가 중간에 비어 있어요(${episode}). 파일 이름을 확인하세요`);\nif (total === 0) return []; // 이미지 없는 폴더(영상만 있는 에피소드)는 조용히 건너뜀\nreturn [{ json: { episode, has_cover: hasCover, start, total } }];"
      }
    },
    {
      "id": "n8",
      "name": "제목 읽기",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('설정').first().json.base_url.replace(/\\/$/, '') }}/{{ $json.episode }}/title.txt",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "id": "m1",
      "name": "파일 목록 읽기",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        400,
        200
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/files/media/*/title.txt",
        "options": {}
      }
    },
    {
      "id": "m2",
      "name": "에피소드 정렬",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        200
      ],
      "parameters": {
        "jsCode": "const eps = [];\nfor (const it of $input.all()) {\n  const dir = it.binary && it.binary.data && it.binary.data.directory;\n  if (!dir) continue;\n  const ep = String(dir).split('/').filter(Boolean).pop();\n  if (/^\\d{4}-\\d{2}-\\d{2}_\\d{3}$/.test(ep)) eps.push(ep);\n}\nreturn [...new Set(eps)].sort().map((episode) => ({ json: { episode } }));"
      }
    },
    {
      "id": "m3",
      "name": "올릴 파일 확인 후보",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "jsCode": "const s = $('설정').first().json;\nconst base = String(s.base_url).replace(/\\/$/, '');\nconst out = [];\nfor (const it of $input.all()) {\n  const ep = it.json.episode;\n  for (const f of ['00', '01']) out.push({ json: { episode: ep, url: `${base}/${ep}/${f}.jpg` } });\n}\nreturn out;"
      }
    },
    {
      "id": "m4",
      "name": "올릴 파일 확인",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "method": "HEAD",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "m5",
      "name": "준비된 것만 고르기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        200
      ],
      "parameters": {
        "jsCode": "const cands = $('올릴 파일 확인 후보').all();\nconst res = $input.all();\nconst ready = new Set();\ncands.forEach((c, i) => { if (res[i] && res[i].json.statusCode === 200) ready.add(c.json.episode); });\nreturn $('이미 올렸나? 확인').all()\n  .filter((it) => ready.has(it.json.episode))\n  .map((it) => ({ json: { episode: it.json.episode } }));"
      }
    },
    {
      "id": "k1",
      "name": "표시 내용 만들기",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        4800,
        200
      ],
